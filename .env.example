# ---------------------------------------------------------------
# HaieRag configuration. Copy to .env and fill in secrets.
# Generate secrets with:  openssl rand -base64 48
# ---------------------------------------------------------------
APP_NAME=HaieRag
APP_ENV=development

# --- PostgreSQL (pgvector) ---
# Hosts below are for natively-run services; docker-compose overrides them for containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=haierag
POSTGRES_USER=haierag
POSTGRES_PASSWORD=change-me-postgres

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# --- Object storage (RustFS, S3 compatible) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=haierag
STORAGE_SECRET_KEY=change-me-minio-secret
STORAGE_BUCKET=haierag-documents

# --- Security ---
# HS256 secret for access tokens: >= 32 bytes
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
# Shared secret between backend and AI service (internal API)
INTERNAL_API_TOKEN=change-me-internal-token
# Comma separated browser origins allowed to call the backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Email that becomes system ADMIN on registration (optional)
BOOTSTRAP_ADMIN_EMAIL=

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=50

# --- Local AI (Ollama runs natively on macOS) ---
# OLLAMA_BASE_URL is used by natively-run services; containers use OLLAMA_DOCKER_BASE_URL
# (never 'localhost' inside a container on macOS).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_KEEP_ALIVE=5m
LLM_MODEL=qwen3:4b
LLM_CONTEXT_LENGTH=8192
LLM_TEMPERATURE=0.2
# includes the hidden reasoning tokens of thinking models
LLM_MAX_OUTPUT_TOKENS=2048
# qwen3:4b (2507) always reasons; true makes Ollama return reasoning separately (it is discarded)
LLM_THINKING=true
# max hidden reasoning tokens before the answer is forced (bounds latency, prevents empty answers); 0 = unlimited
LLM_THINKING_BUDGET=512

EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=8

RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BATCH_SIZE=4
RERANKER_DEVICE=auto
RERANKER_IDLE_UNLOAD_SECONDS=300
RERANKER_UNLOAD_BEFORE_GENERATION=false
RERANK_MIN_SCORE=0.05

# --- Link import (ADR-018) ---
# Links resolving to private/loopback/link-local addresses are refused (SSRF protection).
# Set true ONLY on a trusted network where importing intranet pages is intended.
URL_IMPORT_ALLOW_PRIVATE=false
URL_IMPORT_TIMEOUT_SECONDS=20
URL_IMPORT_MAX_REDIRECTS=5

# --- Retrieval ---
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RRF_K=60
RRF_VECTOR_WEIGHT=1.0
RRF_KEYWORD_WEIGHT=1.0

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Concurrency ---
MAX_PARALLEL_INFERENCE=1

# --- Service URLs (native dev defaults; docker-compose overrides them) ---
AI_SERVICE_URL=http://localhost:8000
BACKEND_URL=http://localhost:8080
